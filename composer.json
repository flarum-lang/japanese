{
	"name": "flarum-lang/japanese",
	"description": "Japanese Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/japanese",
	"license": "MIT",
	"authors": [
		{
			"name": "takumi9942",
			"homepage": "https://github.com/takumi9942",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/japanese/issues",
		"forum": "https://discuss.flarum.org/d/23757",
		"source": "https://github.com/flarum-lang/japanese"
	},
	"require": {
		"flarum/core": "^1.0"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "3.x-dev"
		},
		"flarum-extension": {
			"title": "Japanese",
			"category": "language",
			"icon": {
